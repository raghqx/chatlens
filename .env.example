# chatlens needs no secrets to run the dashboard. Parsing, analytics and every
# chart work with an empty environment.
#
# GROQ_API_KEY (optional) enables the shared free tier for the AI reading, so
# visitors without an Anthropic key still get a result. Free, no card required:
#   https://console.groq.com/keys
# Leave it unset and the app asks each visitor for their own Anthropic key.
GROQ_API_KEY=

# Optional. Used ONLY by `npm run eval` (the LLM-judge suite), never by the app.
# That suite calls the real Anthropic API and costs money.
ANTHROPIC_API_KEY=
