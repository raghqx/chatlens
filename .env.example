# chatlens needs no server-side secrets to run.
#
# The app is bring-your-own-key: visitors paste their own Anthropic key in the
# browser, it is held in sessionStorage for that tab only, and it is forwarded
# per request as a bearer token. Nothing is stored server-side, so there is no
# key to configure here and no database to provision.
#
# The variable below is used ONLY by the tier-2 eval suite (`npm run eval`),
# which calls the real API and costs money. It is never read by the app itself.
ANTHROPIC_API_KEY=
